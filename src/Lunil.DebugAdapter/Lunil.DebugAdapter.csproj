<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>lunil-debug-adapter</AssemblyName>
    <RootNamespace>Lunil.DebugAdapter</RootNamespace>
    <Description>Debug Adapter Protocol server for Lunil Lua debugging.</Description>
    <PublishReadyToRun Condition="'$(LunilReadyToRunPublish)' == 'true'">true</PublishReadyToRun>
    <SelfContained Condition="'$(LunilReadyToRunPublish)' == 'true'">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lunil.Compiler\Lunil.Compiler.csproj" />
    <ProjectReference Include="..\Lunil.Core\Lunil.Core.csproj" />
    <ProjectReference Include="..\Lunil.Runtime\Lunil.Runtime.csproj" />
  </ItemGroup>

</Project>
