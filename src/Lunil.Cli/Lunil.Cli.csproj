<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>lunil</AssemblyName>
    <RootNamespace>Lunil.Cli</RootNamespace>
    <PackageId>Lunil.Cli</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lunil</ToolCommandName>
    <Description>Command-line compiler, analyzer, runner, and Lua chunk builder for Lunil.</Description>
    <PackageTags>lua;lua54;cli;compiler;analysis;dotnet-tool</PackageTags>
    <PublishAot Condition="'$(LunilNativeAotPublish)' == 'true'">true</PublishAot>
    <PublishReadyToRun Condition="'$(LunilReadyToRunPublish)' == 'true'">true</PublishReadyToRun>
    <SelfContained Condition="'$(LunilNativeAotPublish)' == 'true' Or '$(LunilReadyToRunPublish)' == 'true'">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lunil.CodeGen.Cil\Lunil.CodeGen.Cil.csproj" />
    <ProjectReference Include="..\Lunil.Compiler\Lunil.Compiler.csproj" />
    <ProjectReference Include="..\Lunil.Core\Lunil.Core.csproj" />
    <ProjectReference Include="..\Lunil.EmmyLua\Lunil.EmmyLua.csproj" />
    <ProjectReference Include="..\Lunil.Hosting\Lunil.Hosting.csproj" />
    <ProjectReference Include="..\Lunil.IR\Lunil.IR.csproj" />
    <ProjectReference Include="..\Lunil.Runtime\Lunil.Runtime.csproj" />
    <ProjectReference Include="..\Lunil.StandardLibrary\Lunil.StandardLibrary.csproj" />
    <ProjectReference Include="..\Lunil.Syntax\Lunil.Syntax.csproj" />
    <ProjectReference Include="..\Lunil.Workspace\Lunil.Workspace.csproj" />
  </ItemGroup>


  <!-- The product version is baked in at compile time from $(Version) so no runtime
       reflection over assembly metadata is needed to report it. -->
  <Target Name="GenerateLunilProductVersion" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <LunilProductVersionBare Condition="'$(Version)' != ''">$(Version)</LunilProductVersionBare>
      <LunilProductVersionBare Condition="'$(Version)' == ''">0.0.0</LunilProductVersionBare>
    </PropertyGroup>
    <ItemGroup>
      <LunilProductVersionLines Include="// &lt;auto-generated /&gt;" />
      <LunilProductVersionLines Include="namespace Lunil.Cli%3B" />
      <LunilProductVersionLines Include=" " />
      <LunilProductVersionLines Include="internal static class LunilProductVersion" />
      <LunilProductVersionLines Include="{" />
      <LunilProductVersionLines Include="    public const string InformationalVersion = &quot;$(LunilProductVersionBare)&quot;%3B" />
      <LunilProductVersionLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile
        File="$(IntermediateOutputPath)LunilProductVersion.g.cs"
        Lines="@(LunilProductVersionLines)"
        Overwrite="true"
        Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)LunilProductVersion.g.cs" />
    </ItemGroup>
  </Target>
</Project>
