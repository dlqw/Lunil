<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>lunil-language-server</AssemblyName>
    <RootNamespace>Lunil.LanguageServer</RootNamespace>
    <Description>LSP 3.17 language server for Lunil Lua analysis.</Description>
    <!-- A long-running multi-core analysis host: server GC with DATAS keeps indexing
         bursts off the message loop while shrinking heaps when the session is idle.
         The heap hard limit turns any future unbounded growth into a bounded failure
         instead of consuming the whole machine. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <GCHeapHardLimitPercent>60</GCHeapHardLimitPercent>
    <PublishReadyToRun Condition="'$(LunilReadyToRunPublish)' == 'true'">true</PublishReadyToRun>
    <SelfContained Condition="'$(LunilReadyToRunPublish)' == 'true'">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="BuiltinLibrary\builtin-base.lua" />
    <EmbeddedResource Include="BuiltinLibrary\builtin-coroutine.lua" />
    <EmbeddedResource Include="BuiltinLibrary\builtin-debug.lua" />
    <EmbeddedResource Include="BuiltinLibrary\builtin-io.lua" />
    <EmbeddedResource Include="BuiltinLibrary\builtin-math.lua" />
    <EmbeddedResource Include="BuiltinLibrary\builtin-os.lua" />
    <EmbeddedResource Include="BuiltinLibrary\builtin-string.lua" />
    <EmbeddedResource Include="BuiltinLibrary\builtin-table.lua" />
    <EmbeddedResource Include="BuiltinLibrary\builtin-utf8.lua" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lunil.Compiler\Lunil.Compiler.csproj" />
    <ProjectReference Include="..\Lunil.Analysis\Lunil.Analysis.csproj" />
    <ProjectReference Include="..\Lunil.Core\Lunil.Core.csproj" />
    <ProjectReference Include="..\Lunil.Semantics\Lunil.Semantics.csproj" />
    <ProjectReference Include="..\Lunil.Syntax\Lunil.Syntax.csproj" />
    <ProjectReference Include="..\Lunil.Workspace\Lunil.Workspace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lunil.LanguageServer.Tests" />
  </ItemGroup>


  <!-- The product version is baked in at compile time from $(Version) so no runtime
       reflection over assembly metadata is needed to report it. -->
  <Target Name="GenerateLunilProductVersion" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <LunilProductVersionBare Condition="'$(Version)' != ''">$(Version)</LunilProductVersionBare>
      <LunilProductVersionBare Condition="'$(Version)' == ''">0.0.0</LunilProductVersionBare>
    </PropertyGroup>
    <ItemGroup>
      <LunilProductVersionLines Include="// &lt;auto-generated /&gt;" />
      <LunilProductVersionLines Include="namespace Lunil.LanguageServer%3B" />
      <LunilProductVersionLines Include=" " />
      <LunilProductVersionLines Include="internal static class LunilProductVersion" />
      <LunilProductVersionLines Include="{" />
      <LunilProductVersionLines Include="    public const string InformationalVersion = &quot;$(LunilProductVersionBare)&quot;%3B" />
      <LunilProductVersionLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile
        File="$(IntermediateOutputPath)LunilProductVersion.g.cs"
        Lines="@(LunilProductVersionLines)"
        Overwrite="true"
        Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)LunilProductVersion.g.cs" />
    </ItemGroup>
  </Target>
</Project>
