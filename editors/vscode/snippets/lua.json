{
  "local function": {
    "prefix": "lf",
    "body": [
      "local function ${1:name}(${2:params})",
      "\t${0:-- body}",
      "end"
    ],
    "description": "local function declaration"
  },
  "function": {
    "prefix": "fn",
    "body": [
      "function ${1:name}(${2:params})",
      "\t${0:-- body}",
      "end"
    ],
    "description": "global function declaration"
  },
  "local function with annotation": {
    "prefix": "lfa",
    "body": [
      "---@param ${1:name} ${2:type}",
      "---@return ${3:type}",
      "local function ${1:name}(${4:params})",
      "\t${0:-- body}",
      "end"
    ],
    "description": "annotated local function"
  },
  "method": {
    "prefix": "m",
    "body": [
      "function ${1:class}:${2:name}(${3:self})",
      "\t${0:-- body}",
      "end"
    ],
    "description": "method with implicit self"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:condition} then",
      "\t${0:-- body}",
      "end"
    ],
    "description": "if block"
  },
  "if else": {
    "prefix": "ife",
    "body": [
      "if ${1:condition} then",
      "\t${2:-- then body}",
      "else",
      "\t${0:-- else body}",
      "end"
    ],
    "description": "if-else block"
  },
  "elseif": {
    "prefix": "eif",
    "body": [
      "elseif ${1:condition} then",
      "\t${0:-- body}"
    ],
    "description": "elseif clause"
  },
  "numeric for": {
    "prefix": "forn",
    "body": [
      "for ${1:i} = ${2:1}, ${3:n}${4:, ${5:step}} do",
      "\t${0:-- body}",
      "end"
    ],
    "description": "numeric for loop"
  },
  "generic for": {
    "prefix": "for",
    "body": [
      "for ${1:index}, ${2:value} in ${3:ipairs(t)} do",
      "\t${0:-- body}",
      "end"
    ],
    "description": "generic for loop"
  },
  "while": {
    "prefix": "wh",
    "body": [
      "while ${1:condition} do",
      "\t${0:-- body}",
      "end"
    ],
    "description": "while loop"
  },
  "repeat": {
    "prefix": "rep",
    "body": [
      "repeat",
      "\t${0:-- body}",
      "until ${1:condition}"
    ],
    "description": "repeat-until loop"
  },
  "local table": {
    "prefix": "lt",
    "body": "local ${1:name} = { ${0} }",
    "description": "local table constructor"
  },
  "table field": {
    "prefix": "tf",
    "body": "${1:key} = ${0:value}",
    "description": "named table field"
  },
  "metatable class": {
    "prefix": "class",
    "body": [
      "local ${1:Class} = {}",
      "${1:Class}.__index = ${1:Class}",
      "",
      "function ${1:Class}.new(${2:fields})",
      "\tlocal self = setmetatable({}, ${1:Class})",
      "\t${0:-- initialize fields}",
      "\treturn self",
      "end",
      "",
      "return ${1:Class}"
    ],
    "description": "metatable-backed class"
  },
  "setmetatable": {
    "prefix": "setm",
    "body": "setmetatable(${1:t}, { __index = ${2:fallback} })",
    "description": "setmetatable with __index"
  },
  "pcall": {
    "prefix": "pcall",
    "body": [
      "local ok, ${1:result} = pcall(${2:fn}${3:, ${4:args}})",
      "if not ok then",
      "\t${0:-- handle error}",
      "end"
    ],
    "description": "protected call with error handling"
  },
  "error with level": {
    "prefix": "err",
    "body": "error(${1:message}, ${2:level})",
    "description": "error with message and level"
  },
  "coroutine wrap": {
    "prefix": "cow",
    "body": [
      "local ${1:gen} = coroutine.wrap(function()",
      "\t${0:-- yield values}",
      "end)"
    ],
    "description": "coroutine.wrap generator"
  },
  "return multiple values": {
    "prefix": "ret",
    "body": "return ${1:value}, ${0:second}",
    "description": "return multiple values"
  },
  "varargs forward": {
    "prefix": "vaf",
    "body": "local ${1:args} = table.pack(...)",
    "description": "pack varargs"
  },
  "annotated class": {
    "prefix": "--class",
    "body": [
      "---@class ${1:Name}${2:: ${3:Parent}}",
      "---@field ${4:field} ${5:type}",
      "local ${1:Name} = {}"
    ],
    "description": "---@class annotation with a field"
  },
  "annotation param": {
    "prefix": "--param",
    "body": "---@param ${1:name} ${2:type}${3:? ${4:description}}",
    "description": "---@param annotation"
  },
  "annotation return": {
    "prefix": "--return",
    "body": "---@return ${1:type} ${2:name}",
    "description": "---@return annotation"
  },
  "annotation type": {
    "prefix": "--type",
    "body": "---@type ${1:type}",
    "description": "---@type annotation"
  },
  "annotation alias": {
    "prefix": "--alias",
    "body": [
      "---@alias ${1:Name} ${2:type}",
      "---@see ${1:Name}"
    ],
    "description": "---@alias annotation"
  },
  "annotation field": {
    "prefix": "--field",
    "body": "---@field ${1:field} ${2:type}",
    "description": "---@field annotation"
  },
  "annotation generic": {
    "prefix": "--generic",
    "body": "---@generic ${1:T} : ${2:base}",
    "description": "---@generic annotation"
  },
  "annotation overload": {
    "prefix": "--overload",
    "body": "---@overload fun(${1:args}): ${2:returns}",
    "description": "---@overload annotation"
  }
}
