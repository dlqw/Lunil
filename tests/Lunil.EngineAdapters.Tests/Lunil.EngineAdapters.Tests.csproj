<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS8613</NoWarn>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);CS8600;CS8613;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lunil.Hosting\Lunil.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\integrations\unity\com.dlqw.lunil\Runtime\LuaScriptAsset.cs"
             Link="Adapters\Unity\LuaScriptAsset.cs" />
    <Compile Include="..\..\integrations\unity\com.dlqw.lunil\Runtime\LuaUnityServices.cs"
             Link="Adapters\Unity\LuaUnityServices.cs" />
    <Compile Include="..\..\src\Lunil.Godot\LuaGodotScriptResource.cs"
             Link="Adapters\Godot\LuaGodotScriptResource.cs" />
    <Compile Include="..\..\src\Lunil.Godot\LuaGodotServices.cs"
             Link="Adapters\Godot\LuaGodotServices.cs" />
  </ItemGroup>

</Project>
